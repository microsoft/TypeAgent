<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NoWarn>$(NoWarn);SYSLIB1054;CA1838;CA2101</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Mxc.Sdk" Version="1.0.0" />
    <Compile Include="..\powerShellSandboxBroker\BrokerProtocol.cs" Link="BrokerProtocol.cs" />
    <Compile Include="..\powerShellSandboxBroker\NativeMethods.cs" Link="NativeMethods.cs" />
    <Compile Include="..\powerShellSandboxBroker\PowerShellProcess.cs" Link="PowerShellProcess.cs" />
    <Content Include="..\..\ts\packages\agents\powershell\scripts\scriptHost.ps1"
             Link="scriptHost.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
