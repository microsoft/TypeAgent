{
  "name": "@typeagent/browser-control-rpc",
  "version": "0.0.1",
  "description": "Browser control types and content script RPC client for TypeAgent",
  "homepage": "https://github.com/microsoft/TypeAgent#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/TypeAgent.git",
    "directory": "ts/packages/agents/browserControlRpc"
  },
  "license": "MIT",
  "author": "Microsoft",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "exports": {
    "./types": "./dist/browserControl.js",
    "./webAgentMessageTypes": "./dist/webAgentMessageTypes.js",
    "./serviceTypes": "./dist/serviceTypes.js",
    "./viewRpc": "./dist/viewRpc.js",
    "./runbookImportViewTypes": "./dist/runbookImportViewTypes.js",
    "./viewRoutes": "./dist/viewRoutes.js",
    "./extensionEvents": "./dist/extensionEvents.js",
    "./platformServices": "./dist/platformServices.js",
    "./htmlReducer": "./dist/crossContextHtmlReducer.js",
    "./pdfTypes": "./dist/pdfTypes.js",
    "./pdfMarkdown": "./dist/pdfMarkdown.js",
    "./answerEnhancement": "./dist/answerEnhancement.js",
    "./contentScriptRpc/types": "./dist/contentScriptRpc/types.js",
    "./contentScriptRpc/client": "./dist/contentScriptRpc/client.js"
  },
  "scripts": {
    "build": "npm run tsc && node ../../../tools/scripts/converters/pdfToMarkdown/build-artifacts.mjs",
    "clean": "rimraf --glob dist *.tsbuildinfo *.done.build.log",
    "prettier": "prettier --check . --ignore-path ../../../.prettierignore",
    "prettier:fix": "prettier --write . --ignore-path ../../../.prettierignore",
    "tsc": "tsc -b",
    "test:pdf": "node --test test/pdfMarkdown.spec.mjs test/pdfToMarkdown/*.test.mjs test/memoryImportContract.spec.mjs"
  },
  "dependencies": {
    "@typeagent/agent-rpc": "workspace:*",
    "@typeagent/memory-service": "workspace:*",
    "dompurify": "^3.4.13",
    "jsdom": "^28.1.0",
    "pdfjs-dist": "5.3.31"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "pdfjs-baseline": "npm:pdfjs-dist@4.10.38",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "~5.4.5"
  }
}
