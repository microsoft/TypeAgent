// Generated grammar for listSchema
// This file contains common patterns for user requests
// Types: wildcard = 1+ words, word = exactly 1 word

// ---------------------------------------------------------------------------
// Named-list only. Bare / ambiguous references are intentionally unmatched so
// translation (LLM + history) resolves them — e.g. "add ham to the list",
// "put cheese on the list", "add cheese to both", "add ham to my list".
//
// Safe shape: fixed "the"/"my" + real name + trailing "list". That way the
// determiner cannot be captured as listName. Do not reintroduce optional
// (the)?/(my)? before $(listName), or "to $(listName)" without trailing list.
// Determinerless "add milk to grocery list" also falls through to the LLM
// (same as bare refs); that is not a functional regression — only grammar
// speed — and avoids reopening determiner capture via "to $(listName) list".
// ---------------------------------------------------------------------------

// addItems
<AddItems> =
    (can you)? add $(item:wildcard) to the $(listName:wildcard) list -> {
    actionName: "addItems",
    parameters: {
        items: [item],
        listName
    }
}
  | (can you)? add $(item:wildcard) to my $(listName:wildcard) list -> {
    actionName: "addItems",
    parameters: {
        items: [item],
        listName
    }
}
  | put $(item:wildcard) on the $(listName:wildcard) list -> {
    actionName: "addItems",
    parameters: {
        items: [item],
        listName
    }
}
  | put $(item:wildcard) on my $(listName:wildcard) list -> {
    actionName: "addItems",
    parameters: {
        items: [item],
        listName
    }
}
  | (can you)? add $(item1:wildcard) and $(item2:wildcard) to the $(listName:wildcard) list -> {
    actionName: "addItems",
    parameters: {
        items: [item1, item2],
        listName
    }
}
  | (can you)? add $(item1:wildcard) and $(item2:wildcard) to my $(listName:wildcard) list -> {
    actionName: "addItems",
    parameters: {
        items: [item1, item2],
        listName
    }
};

// removeItems
<RemoveItems> =
    remove $(item:wildcard) from the $(listName:wildcard) list -> {
    actionName: "removeItems",
    parameters: {
        items: [item],
        listName
    }
}
  | remove $(item:wildcard) from my $(listName:wildcard) list -> {
    actionName: "removeItems",
    parameters: {
        items: [item],
        listName
    }
}
  | (can you)? delete $(item:wildcard) from the $(listName:wildcard) list -> {
    actionName: "removeItems",
    parameters: {
        items: [item],
        listName
    }
}
  | (can you)? delete $(item:wildcard) from my $(listName:wildcard) list -> {
    actionName: "removeItems",
    parameters: {
        items: [item],
        listName
    }
}
  | take $(item:wildcard) off the $(listName:wildcard) list -> {
    actionName: "removeItems",
    parameters: {
        items: [item],
        listName
    }
}
  | take $(item:wildcard) off my $(listName:wildcard) list -> {
    actionName: "removeItems",
    parameters: {
        items: [item],
        listName
    }
};

// createList — any listName including "my" is fine; reference resolution is
// translation's job, not the list agent.
<CreateList> = create (a)? (new)? $(listName:wildcard) list -> {
    actionName: "createList",
    parameters: {
        listName
    }
}
  | (can you)? make (me)? (a)? (new)? $(listName:wildcard) list -> {
    actionName: "createList",
    parameters: {
        listName
    }
}
  | start (a)? (new)? $(listName:wildcard) list -> {
    actionName: "createList",
    parameters: {
        listName
    }
};

// getList — same named-only shape (not bare "the list" / "my list")
<GetList> =
    what's on the $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what's on my $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what (is)? on the $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what (is)? on my $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what's the $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what's my $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | (can you)? show (me)? the $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | (can you)? show (me)? my $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what (do)? I have on the $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what (do)? I have on my $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
};

// clearList — require a clear intent word so this does not steal
// "delete <item> from the <name> list" from removeItems.
<ClearList> =
    clear the $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
}
  | clear my $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
}
  | (can you)? empty the $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
}
  | (can you)? empty my $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
}
  | delete everything from the $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
}
  | delete everything from my $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
}
  | delete all items from the $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
}
  | delete all items from my $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
};

// listLists
<ListLists> = (can you)? (list | show | display) (me)? (all | my | the)? lists -> {
    actionName: "listLists",
    parameters: {}
}
  | (what | which) lists (do | are)? (i | we | there)? (have)? -> {
    actionName: "listLists",
    parameters: {}
};

import { ListAction } from "./listSchema.ts";

// ClearList before RemoveItems so "delete everything|all items from … list"
// is not stolen by removeItems with item="everything".
<Start> : ListAction = <AddItems>
  | <CreateList>
  | <GetList>
  | <ClearList>
  | <RemoveItems>
  | <ListLists>;
