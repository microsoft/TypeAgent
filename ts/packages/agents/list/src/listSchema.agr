// Generated grammar for listSchema
// This file contains common patterns for user requests
// Types: wildcard = 1+ words, word = exactly 1 word

// addItems - add one or more items to a *named* list only.
//
// Rules require a real name between a fixed determiner ("the"/"my") and the
// trailing "list" word, e.g. "add milk to the grocery list". Bare references
// are intentionally unmatched so translation can resolve them from history or
// clarify — "add ham to the list", "add cheese to both", "put cheese on the
// list". Do not reintroduce optional (the)?/(my)? before $(listName): those
// let the determiner itself become listName. See schema-tuning.md note #5.
<AddItems> = (can you)? add $(item:wildcard) to the $(listName:wildcard) list -> {
    actionName: "addItems",
    parameters: {
        items: [item],
        listName
    }
}
  | (can you)? add $(item:wildcard) to my $(listName:wildcard) list -> {
    actionName: "addItems",
    parameters: {
        items: [item],
        listName
    }
}
  | put $(item:wildcard) on the $(listName:wildcard) list -> {
    actionName: "addItems",
    parameters: {
        items: [item],
        listName
    }
}
  | put $(item:wildcard) on my $(listName:wildcard) list -> {
    actionName: "addItems",
    parameters: {
        items: [item],
        listName
    }
}
  | add $(item1:wildcard) and $(item2:wildcard) to the $(listName:wildcard) list -> {
    actionName: "addItems",
    parameters: {
        items: [item1, item2],
        listName
    }
}
  | add $(item1:wildcard) and $(item2:wildcard) to my $(listName:wildcard) list -> {
    actionName: "addItems",
    parameters: {
        items: [item1, item2],
        listName
    }
};

// removeItems - remove one or more items from a named list (same named-only rule)
<RemoveItems> = remove $(item:wildcard) from the $(listName:wildcard) list -> {
    actionName: "removeItems",
    parameters: {
        items: [item],
        listName
    }
}
  | remove $(item:wildcard) from my $(listName:wildcard) list -> {
    actionName: "removeItems",
    parameters: {
        items: [item],
        listName
    }
}
  | (can you)? delete $(item:wildcard) from the $(listName:wildcard) list -> {
    actionName: "removeItems",
    parameters: {
        items: [item],
        listName
    }
}
  | (can you)? delete $(item:wildcard) from my $(listName:wildcard) list -> {
    actionName: "removeItems",
    parameters: {
        items: [item],
        listName
    }
}
  | take $(item:wildcard) off the $(listName:wildcard) list -> {
    actionName: "removeItems",
    parameters: {
        items: [item],
        listName
    }
}
  | take $(item:wildcard) off my $(listName:wildcard) list -> {
    actionName: "removeItems",
    parameters: {
        items: [item],
        listName
    }
};

// createList - create a new list
// listName may be any word(s), including "my"; reference resolution belongs
// in translation, not the list agent.
<CreateList> = create (a)? (new)? $(listName:wildcard) list -> {
    actionName: "createList",
    parameters: {
        listName
    }
}
  | (can you)? make (me)? (a)? (new)? $(listName:wildcard) list -> {
    actionName: "createList",
    parameters: {
        listName
    }
}
  | start (a)? (new)? $(listName:wildcard) list -> {
    actionName: "createList",
    parameters: {
        listName
    }
};

// getList - show what's on a named list
// Require a real name before trailing "list" (not bare "the list" / "my list").
<GetList> = what's on the $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what's on my $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what (is)? on the $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what (is)? on my $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what's the $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what's my $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | (can you)? show (me)? the $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | (can you)? show (me)? my $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what (do)? I have on the $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
}
  | what (do)? I have on my $(listName:wildcard) list -> {
    actionName: "getList",
    parameters: {
        listName
    }
};

// clearList - clear all items from a named list
<ClearList> = clear the $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
}
  | clear my $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
}
  | (can you)? empty the $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
}
  | (can you)? empty my $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
}
  | delete (everything)? (all items)? from the $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
}
  | delete (everything)? (all items)? from my $(listName:wildcard) list -> {
    actionName: "clearList",
    parameters: {
        listName
    }
};

// listLists - show which lists exist
// The literal word "lists" anchors these rules so they beat wildcard-heavy
// patterns and the system.conversation listConversation rule.
<ListLists> = (can you)? (list | show | display) (me)? (all | my | the)? lists -> {
    actionName: "listLists",
    parameters: {}
}
  | (what | which) lists (do | are)? (i | we | there)? (have)? -> {
    actionName: "listLists",
    parameters: {}
};

import { ListAction } from "./listSchema.ts";

<Start> : ListAction = <AddItems>
  | <RemoveItems>
  | <CreateList>
  | <GetList>
  | <ClearList>
  | <ListLists>;
