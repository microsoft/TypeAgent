// Generated grammar for calendarSchema
// This file contains common patterns for user requests
// Types: wildcard = 1+ words, word = exactly 1 word

// scheduleEvent
// Prefer specific multi-field patterns first; shorter day-to-day forms follow
// (e.g. "schedule a design review for next tuesday at 3pm" without location).
<ScheduleEvent> = schedule a $(description:wildcard) for $(date:wildcard) at $(time:word) in $(location:wildcard) with $(participant:wildcard) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time,
        location,
        participant
    }
}
  | schedule a $(description:wildcard) for $(date:wildcard) at $(time:word) with $(participant:wildcard) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time,
        participant
    }
}
  | schedule a $(description:wildcard) for $(date:wildcard) at $(time:word) in $(location:wildcard) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time,
        location
    }
}
  | schedule a $(description:wildcard) for $(date:wildcard) at $(time:word) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time
    }
}
  | (can you)? set up $(description:wildcard) on $(date:wildcard) at $(time:word) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time
    }
}
  | book $(description:wildcard) with $(participant:wildcard) at $(location:wildcard) $(date:wildcard) at $(time:word) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time,
        location,
        participant
    }
}
  // Adjacent $(word) $(word) needs a literal separator; use RelativeDay or "for"/"on".
  | book $(description:wildcard) with $(participant:word) for $(date:wildcard) at $(time:word) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time,
        participant
    }
}
  | book $(description:wildcard) with $(participant:word) on $(date:wildcard) at $(time:word) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time,
        participant
    }
}
  | book $(description:word) with $(participant:word) $(date:<RelativeDay>) at $(time:word) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time,
        participant
    }
};

// Single-token relative days so "book lunch with alex tomorrow at noon" can bind
// participant + date without two free adjacent wildcards.
<RelativeDay> = today | tomorrow | tonight
  | monday | tuesday | wednesday | thursday | friday | saturday | sunday
  | mon | tue | wed | thu | fri | sat | sun;

// findEvents
<FindEvents> = find all events on $(date:wildcard) that include $(participant:wildcard) -> {
    actionName: "findEvents",
    parameters: {
        date,
        participant
    }
}
  | show me meetings about $(description:wildcard) scheduled for $(date:wildcard) -> {
    actionName: "findEvents",
    parameters: {
        description,
        date
    }
}
  | what events do I have with $(participant:wildcard) on $(date:wildcard) about (the)? $(description:wildcard) -> {
    actionName: "findEvents",
    parameters: {
        date,
        participant,
        description
    }
};

// addParticipant
<AddParticipant> = include $(participant:wildcard) in $(description:wildcard) -> {
    actionName: "addParticipant",
    parameters: {
        description,
        participant
    }
};

// findTodaysEvents
// Bare "what's on my calendar" (no trailing date) is a common day-to-day ask.
<FindTodaysEvents> = what's on my calendar $(date:wildcard) -> {
    actionName: "findTodaysEvents"
}
  | what is on my calendar $(date:wildcard) -> {
    actionName: "findTodaysEvents"
}
  | what's on my calendar -> {
    actionName: "findTodaysEvents"
}
  | what is on my calendar -> {
    actionName: "findTodaysEvents"
}
  | show me all my appointments and meetings for $(date:wildcard) -> {
    actionName: "findTodaysEvents"
}
  | (can you)? (tell me)? what (do)? I have scheduled for today -> {
    actionName: "findTodaysEvents"
};

// findThisWeeksEvents

import { CalendarActionV3 } from "./calendarActionsSchemaV3.ts";

<Start> : CalendarActionV3 = <ScheduleEvent>
  | <FindEvents>
  | <AddParticipant>
  | <FindTodaysEvents>
  | <FindThisWeeksEvents>;

<FindThisWeeksEvents> = what's happening this week -> {
    actionName: "findThisWeeksEvents"
}
  | show me all my events for this week starting $(startDay:word) -> {
    actionName: "findThisWeeksEvents"
}
  | (can you)? find what I have scheduled this week -> {
    actionName: "findThisWeeksEvents"
};
