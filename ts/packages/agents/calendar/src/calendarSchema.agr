// Generated grammar for calendarSchema
// This file contains common patterns for user requests
// Types: wildcard = 1+ words, word = exactly 1 word

// scheduleEvent
<ScheduleEvent> = schedule a $(description:wildcard) for $(date:wildcard) at $(time:word) in $(location:wildcard) with $(participant:wildcard) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time,
        location,
        participant
    }
}
  | (can you)? set up $(description:wildcard) on $(date:wildcard) at $(time:word) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time
    }
}
  | book $(description:wildcard) with $(participant:wildcard) at $(location:wildcard) $(date:wildcard) at $(time:word) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time,
        location,
        participant
    }
}
  // Multi-word participant + explicit for/on date
  // e.g. "book sync with mary jane for friday at noon"
  | book $(description:wildcard) with $(participant:wildcard) (for | on) $(date:wildcard) at $(time:word) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time,
        participant
    }
}
  // Multi-word participant + bare single-token day
  // e.g. "book sync with mary jane friday at noon"
  // RelativeDay is a closed literal set so the day is not absorbed into participant.
  // Does not compete with the at-location alternative (that requires "at $(location)").
  | book $(description:wildcard) with $(participant:wildcard) $(date:<RelativeDay>) at $(time:word) -> {
    actionName: "scheduleEvent",
    parameters: {
        description,
        date,
        time,
        participant
    }
};

// Single-token relative days only (not "next tuesday" — use for/on above).
<RelativeDay> = today | tomorrow | tonight
  | monday | tuesday | wednesday | thursday | friday | saturday | sunday
  | mon | tue | wed | thu | fri | sat | sun;

// findEvents
<FindEvents> = find all events on $(date:wildcard) that include $(participant:wildcard) -> {
    actionName: "findEvents",
    parameters: {
        date,
        participant
    }
}
  | show me meetings about $(description:wildcard) scheduled for $(date:wildcard) -> {
    actionName: "findEvents",
    parameters: {
        description,
        date
    }
}
  | what events do I have with $(participant:wildcard) on $(date:wildcard) about (the)? $(description:wildcard) -> {
    actionName: "findEvents",
    parameters: {
        date,
        participant,
        description
    }
};

// addParticipant
<AddParticipant> = include $(participant:wildcard) in $(description:wildcard) -> {
    actionName: "addParticipant",
    parameters: {
        description,
        participant
    }
};

// findTodaysEvents
<FindTodaysEvents> = what's on my calendar $(date:wildcard) -> {
    actionName: "findTodaysEvents"
}
  | show me all my appointments and meetings for $(date:wildcard) -> {
    actionName: "findTodaysEvents"
}
  | (can you)? (tell me)? what (do)? I have scheduled for today -> {
    actionName: "findTodaysEvents"
};

// findThisWeeksEvents

import { CalendarActionV3 } from "./calendarActionsSchemaV3.ts";

<Start> : CalendarActionV3 = <ScheduleEvent>
  | <FindEvents>
  | <AddParticipant>
  | <FindTodaysEvents>
  | <FindThisWeeksEvents>
  | <CalendarLogin>
  | <CalendarLogout>
  | <CalendarGoogleAuth>;

<CalendarLogin> = (log in | login | sign in) (to)? (my)? (calendar | google calendar | outlook calendar)
    -> { actionName: "calendarLogin" };

<CalendarLogout> = (log out | logout | sign out) (of)? (my)? (calendar | google calendar | outlook calendar)
    -> { actionName: "calendarLogout" };

<CalendarGoogleAuth> = (complete | finish) (setting up)? google calendar (authorization | authentication | oauth | setup)
    -> { actionName: "calendarGoogleAuth" };

<FindThisWeeksEvents> = what's happening this week -> {
    actionName: "findThisWeeksEvents"
}
  | show me all my events for this week starting $(startDay:word) -> {
    actionName: "findThisWeeksEvents"
}
  | (can you)? find what I have scheduled this week -> {
    actionName: "findThisWeeksEvents"
};
