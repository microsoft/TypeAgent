{
  "name": "@typeagent/chat-agent",
  "version": "0.0.1",
  "description": "Agent for conversation and information lookup",
  "keywords": [
    "typeagent-agent"
  ],
  "homepage": "https://github.com/microsoft/TypeAgent#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/TypeAgent.git",
    "directory": "ts/packages/agents/chat"
  },
  "license": "MIT",
  "author": "Microsoft",
  "type": "module",
  "exports": {
    "./agent/manifest": "./src/chatManifest.json",
    "./agent/handlers": "./dist/chatResponseHandler.js"
  },
  "files": [
    "dist",
    "src",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "npm run tsc",
    "postbuild": "copyfiles -u 1 \"src/**/config.json\" dist",
    "clean": "rimraf --glob dist *.tsbuildinfo *.done.build.log",
    "jest-esm": "node --no-warnings --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "prettier": "prettier --check . --ignore-path ../../../.prettierignore",
    "prettier:fix": "prettier --write . --ignore-path ../../../.prettierignore",
    "test": "npm run test:local",
    "test:local": "pnpm run jest-esm --testPathPattern=\".*[.]spec[.]js\"",
    "tsc": "tsc -b"
  },
  "dependencies": {
    "@typeagent/agent-runtime": "workspace:*",
    "@typeagent/agent-sdk": "workspace:*",
    "@typeagent/aiclient": "workspace:*",
    "@typeagent/knowledge-processor": "workspace:*",
    "@typeagent/telemetry": "workspace:*",
    "@typeagent/typechat-utils": "workspace:*",
    "typechat": "^0.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.7",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "~5.4.5"
  },
  "typeagent": {
    "defaultAgentName": "chat"
  }
}
