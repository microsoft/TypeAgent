{
  "name": "@typeagent/memory-agent",
  "version": "0.0.1",
  "description": "First-party TypeAgent durable memory agent",
  "keywords": [
    "typeagent-agent"
  ],
  "homepage": "https://github.com/microsoft/TypeAgent#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/TypeAgent.git",
    "directory": "ts/packages/agents/memory"
  },
  "license": "MIT",
  "author": "Microsoft",
  "type": "module",
  "exports": {
    "./agent/manifest": "./src/memoryManifest.json",
    "./agent/handlers": "./dist/memoryAgent.js"
  },
  "files": [
    "dist",
    "src",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "npm run tsc",
    "clean": "rimraf --glob dist *.tsbuildinfo *.done.build.log",
    "jest-esm": "node --no-warnings --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "prettier": "prettier --check . --ignore-path ../../../.prettierignore",
    "prettier:fix": "prettier --write . --ignore-path ../../../.prettierignore",
    "test": "npm run test:local",
    "test:local": "pnpm run jest-esm --testPathPattern=\".*[.]spec[.]js\"",
    "tsc": "tsc -b"
  },
  "dependencies": {
    "@typeagent/agent-sdk": "workspace:*",
    "@typeagent/memory-service": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.7",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "~5.4.5"
  },
  "fluidBuild": {
    "tasks": {
      "tsc": {
        "dependsOn": [
          "@typeagent/agent-sdk#tsc",
          "@typeagent/memory-service#tsc"
        ],
        "after": [
          "^*"
        ]
      }
    }
  },
  "typeagent": {
    "defaultAgentName": "memory"
  }
}
