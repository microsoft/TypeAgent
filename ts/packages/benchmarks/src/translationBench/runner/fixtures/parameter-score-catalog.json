{
  "version": 1,
  "description": "Frozen parameter score modes for deterministic soft matching. LLM builders must emit one of these modes per field.",
  "modes": {
    "exact": "Chosen value must deep-equal expected",
    "exists": "Key must be present; value ignored",
    "nonempty": "Key must be present and non-empty string/array",
    "ignore": "Field not scored"
  },
  "recommendedByAction": {
    "timer.setReminder": {
      "message": "nonempty",
      "when": "nonempty",
      "kind": "ignore"
    },
    "calendar.scheduleEvent": {
      "description": "nonempty",
      "date": "exact",
      "time": "nonempty",
      "location": "nonempty",
      "participant": "nonempty"
    },
    "list.addItems": {
      "items": "exact",
      "listName": "exact"
    },
    "weather.getCurrentConditions": {
      "location": "exact",
      "units": "ignore"
    }
  }
}
