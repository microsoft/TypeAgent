{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Translation-bench local run config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "models": {
      "type": "object",
      "description": "Per-model Azure deployment quota + optional per-process concurrency cap.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tpmLimit": {
            "type": "number",
            "minimum": 0,
            "description": "Azure deployment TPM quota."
          },
          "maxConcurrency": {
            "type": "integer",
            "minimum": 1,
            "description": "Per-process concurrency cap (safety)."
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "description": "Explicit concurrency; overrides auto-derivation."
          }
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "description": "Defaults inherited by every batch.",
      "properties": {
        "synthesizer": { "$ref": "#/definitions/synthesizer" },
        "eval": { "$ref": "#/definitions/eval" }
      }
    },
    "batches": {
      "type": "object",
      "description": "Named run profiles selected with TB_BATCH=<name>.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "synthesizer": { "$ref": "#/definitions/synthesizer" },
          "eval": { "$ref": "#/definitions/eval" }
        }
      }
    }
  },
  "definitions": {
    "synthesizer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generatorModel": { "type": "string" },
        "reviewerModel": { "type": "string" },
        "caseCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Rows to synthesize."
        },
        "genCases": {
          "type": "integer",
          "minimum": 1,
          "description": "Gen-cases per row (e.g. 2 = 1 pos + 1 neg)."
        },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "headroom": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "models": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "modelConcurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "How many eval models run in parallel."
        },
        "maxCases": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "null = all rows."
        },
        "headroom": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of tpmLimit used for auto-derived concurrency."
        }
      }
    }
  }
}
