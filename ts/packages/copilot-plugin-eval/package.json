{
  "name": "@typeagent/copilot-plugin-eval",
  "version": "0.0.1",
  "description": "Initial end-to-end Copilot plugin evaluation harness",
  "homepage": "https://github.com/microsoft/TypeAgent#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/TypeAgent.git",
    "directory": "ts/packages/copilot-plugin-eval"
  },
  "license": "MIT",
  "author": "Microsoft",
  "type": "module",
  "scripts": {
    "build": "node --check scripts/ghcp-eval.mjs && node --check scripts/ghcp-eval-preflight.mjs && node --check scripts/ghcp-credit-probe.mjs",
    "prettier": "prettier --check . --ignore-path ../../.prettierignore",
    "prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "test": "npm run test:local",
    "test:local": "node --test scripts/test/*.spec.mjs"
  },
  "devDependencies": {
    "@github/copilot-sdk": "1.0.13",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@typeagent/copilot-plugin": "workspace:*",
    "agent-dispatcher": "workspace:*",
    "agent-server": "workspace:*",
    "prettier": "^3.5.3"
  }
}
