    {
      "id": "footer",
      "type": "text",
      "x": 20,
      "y": 750,
      "width": 1088.369384765625,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 712497589,
      "version": 3,
      "versionNonce": 1235076219,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791495591617,
      "link": null,
      "locked": false,
      "text": "Deleting a file/ref is not forgetting. Local cleanup does not erase SSD remnants, backups, snapshots or exported copies.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deleting a file/ref is not forgetting. Local cleanup does not erase SSD remnants, backups, snapshots or exported copies.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MzfcOeFo2pOzSoqxzC7pS",
      "type": "text",
      "x": 25.100067138671875,
      "y": 105.125,
      "width": 289.79986572265625,
      "height": 183.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 2070615221,
      "version": 3,
      "versionNonce": 1379037723,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791495591619,
      "link": null,
      "locked": false,
      "text": "Canonical evidence / runtime\nSource revisions + event\nledger\nJobs + suppression\ntombstones\nNOT a product-repo commit\nstream",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "runtime",
      "originalText": "Canonical evidence / runtime\nSource revisions + event ledger\nJobs + suppression tombstones\nNOT a product-repo commit stream",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IJb48V4uXZ3iw8ad0fiM1",
      "type": "text",
      "x": 418.642578125,
      "y": 105.125,
      "width": 302.71484375,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 1982669243,
      "version": 4,
      "versionNonce": 1979289877,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791495591619,
      "link": null,
      "locked": false,
      "text": "Typed Views + Topics state\nStable IDs + exact evidence\nHuman edits + generated\nbase\nExpected head + service\nactor",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "candidate",
      "originalText": "Typed Views + Topics state\nStable IDs + exact evidence\nHuman edits + generated base\nExpected head + service actor",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oniy_iuCx8csX8hhu-Lrb",
      "type": "text",
      "x": 831.7440795898438,
      "y": 130,
      "width": 316.5118408203125,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 1859122389,
      "version": 3,
      "versionNonce": 754153147,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791495591619,
      "link": null,
      "locked": false,
      "text": "Private bare Git per corpus\nBlobs -> tree -> commit -> ref\nisomorphic-git + repository lock\nRef is the commit boundary",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "git",
      "originalText": "Private bare Git per corpus\nBlobs -> tree -> commit -> ref\nisomorphic-git + repository lock\nRef is the commit boundary",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Kr9LG0VgN0V9EygffQ19E",
      "type": "text",
      "x": 830.9880828857422,
      "y": 370.375,
      "width": 318.0238342285156,
      "height": 131.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 117740085,
      "version": 3,
      "versionNonce": 1731241589,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791495591619,
      "link": null,
      "locked": false,
      "text": "Authorized history /\ncomparisons\nCommitted snapshots only\nNo working tree, remote or Git\nCLI",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "read",
      "originalText": "Authorized history / comparisons\nCommitted snapshots only\nNo working tree, remote or Git CLI",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
