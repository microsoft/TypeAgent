      "versionNonce": 1379037723,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791495591619,
      "link": null,
      "locked": false,
      "text": "Retained evidence\nSource revisions and events\nJobs and tombstones\nOutside view-history.git",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "runtime",
      "originalText": "Retained evidence\nSource revisions and events\nJobs and tombstones\nOutside view-history.git",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
