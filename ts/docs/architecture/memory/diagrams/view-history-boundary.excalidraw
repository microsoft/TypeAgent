    {
      "id": "footer",
      "type": "text",
      "x": 20,
      "y": 750,
      "width": 1135.313232421875,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 712497589,
      "version": 3,
      "versionNonce": 1235076219,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791495591617,
      "link": null,
      "locked": false,
      "text": "Use the service's forget operation to purge local indexes, Views and history. Remove external backups and exports separately.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use the service's forget operation to purge local indexes, Views and history. Remove external backups and exports separately.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MzfcOeFo2pOzSoqxzC7pS",
      "type": "text",
      "x": 26.685577392578125,
      "y": 105.125,
      "width": 286.62884521484375,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
