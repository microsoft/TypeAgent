      "link": null,
      "locked": false,
      "text": "Restart completes cleanup before reads reopen.\nExternal exports / backups remain separate.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Restart completes cleanup before reads reopen.\nExternal exports / backups remain separate.",
      "autoResize": true,
      "lineHeight": 1.25
    },
