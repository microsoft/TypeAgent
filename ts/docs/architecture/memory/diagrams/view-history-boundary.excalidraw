    {
      "id": "recovery",
      "type": "text",
      "x": 410,
      "y": 520,
      "width": 540.3995361328125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
