      "isDeleted": false,
      "boundElements": [],
      "updated": 1791495591619,
      "link": null,
      "locked": false,
      "text": "Views and Topics state\nStable IDs and citations\nHuman edits and base text\nVersion and head guards",
      "fontSize": 21,
