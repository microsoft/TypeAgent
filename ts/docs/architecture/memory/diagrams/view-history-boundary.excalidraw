      "isDeleted": false,
      "boundElements": [],
      "updated": 1791495591617,
      "link": null,
      "locked": false,
      "text": "After a restart, cleanup finishes before reads reopen.\nExports and backups are handled separately.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After a restart, cleanup finishes before reads reopen.\nExports and backups are handled separately.",
      "autoResize": true,
      "lineHeight": 1.25
    },
