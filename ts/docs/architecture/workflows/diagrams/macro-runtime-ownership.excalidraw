      "isDeleted": false,
      "boundElements": [],
      "updated": 1792190046320,
      "link": null,
      "locked": false,
      "text": "Opt-in: plugin owner\nWorkspace and profile store\nOne SQLite writer, session IPC\nNative CLI, no TypeAgent required",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "plugin",
      "originalText": "Opt-in: plugin owner\nWorkspace and profile store\nOne SQLite writer, session IPC\nNative CLI, no TypeAgent required",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qT6hNN7fSvDSvc5mABaZt",
      "type": "text",
