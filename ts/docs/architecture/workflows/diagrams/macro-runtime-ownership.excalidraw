      "isDeleted": false,
      "boundElements": [],
      "updated": 1792190046320,
      "link": null,
      "locked": false,
      "text": "Shared runtime, one active owner\nManager, authoring, compiler, publication, grammar, journals\nChecked code runs in a bounded QuickJS guest\nEach owner keeps a separate catalog",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "shared",
      "originalText": "Shared runtime, one active owner\nManager, authoring, compiler, publication, grammar, journals\nChecked code runs in a bounded QuickJS guest\nEach owner keeps a separate catalog",
      "autoResize": true,
      "lineHeight": 1.25
    },
