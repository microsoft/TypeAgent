      "link": null,
      "locked": false,
      "text": "Default: TypeAgent owner\nAgent-server instance store\nHosted verification, semantics\nNative child authorship available",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "typeagent",
      "originalText": "Default: TypeAgent owner\nAgent-server instance store\nHosted verification, semantics\nNative child authorship available",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TqAWmJPvPXpPJwZo3fiCt",
      "type": "text",
      "x": 676.5041046142578,
