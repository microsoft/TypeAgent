{
  "name": "wiki-views",
  "version": "0.0.1",
  "private": true,
  "description": "Owned-store informational wiki and project-brief examples.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run tsc",
    "tsc": "tsc -b",
    "clean": "rimraf --glob dist *.tsbuildinfo *.done.build.log",
    "wiki-views": "node dist/cli.js",
    "jest-esm": "node --no-warnings --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test": "pnpm run jest-esm --runInBand --testPathPattern=\".*[.]spec[.]js\"",
    "test:local": "pnpm test",
    "prettier": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@typeagent/aiclient": "workspace:*",
    "@typeagent/config": "workspace:*",
    "@typeagent/memory-service": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.7",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "~5.4.5"
  }
}
