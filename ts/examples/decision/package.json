{
  "name": "decision-model-example",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Copilot and Azure decisions samples using TypeAgent AI Client",
  "scripts": {
    "build": "node --check decision.mjs && node --check main.mjs",
    "start": "node main.mjs",
    "test:local": "node --test --test-concurrency=1 decision.spec.mjs */*.spec.mjs",
    "test:azure": "node --test --test-concurrency=1 decision.azure.test.mjs",
    "prettier": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@typeagent/aiclient": "workspace:*",
    "@typeagent/config": "workspace:*",
    "playwright": "1.57.0"
  },
  "engines": {
    "node": ">=22"
  }
}
